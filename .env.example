# Backend only. Keep actual credentials out of model JSON, browser bundles and Git.
# Copy to .env and load it in the server environment; this example contains no keys.
STATE_AI_PORT=4180
STATE_AI_RUNS_DIR=./runs
FFMPEG_PATH=
FFPROBE_PATH=
EDGE_PATH=
TTS_PROVIDER=system
TTS_VOICE=
# Optional cloud TTS parameters; system remains the default. Endpoint/key stay backend only.
TTS_ENDPOINT=
TTS_MODEL=
TTS_API_KEY_ENV=OPENAI_API_KEY

# Optional: required only after explicitly enabling the corresponding API template.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
