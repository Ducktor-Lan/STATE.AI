{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "paths": {
      "@state/arena": ["./packages/arena/src/index.ts"],
      "@state/arena/*": ["./packages/arena/src/*"],
      "@state/providers": ["./packages/providers/src/index.ts"],
      "@state/providers/*": ["./packages/providers/src/*"],
      "@state/media": ["./packages/media/src/index.ts"],
      "@state/media/*": ["./packages/media/src/*"],
      "@state/evaluation": ["./packages/evaluation/src/index.ts"],
      "@state/evaluation/*": ["./packages/evaluation/src/*"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "vendor", ".generated", "dist", "artifacts", "runs", "output", "**/dist/**", "**/.generated/**"]
}
